{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Nodemon 디버그 서버 실행",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["nodemon", "--inspect", "${workspaceFolder}/server/index.js"],
            "restart": true,
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "outputCapture": "std"
        }
    ]
}